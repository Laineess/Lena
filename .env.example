# Leña — plantilla de variables de entorno
#
#   cp .env.example .env
#
# .env NUNCA se sube (RS-T-10). Ya está en .gitignore.
# Este archivo SÍ se sube: es la plantilla.

# ─────────────────────────────────────────────────────────────
# Base de datos
# ─────────────────────────────────────────────────────────────
POSTGRES_USER=lena
POSTGRES_PASSWORD=cambiame_en_local
POSTGRES_DB=lena
POSTGRES_PORT=5432

# Rol DUEÑO: corre migraciones y respaldos. Nunca lo usa el API.
DATABASE_URL=postgresql://lena:cambiame_en_local@localhost:5432/lena

# Rol de la APLICACIÓN: sin UPDATE/DELETE en las tablas de auditoría.
# Es lo que hace real al log append-only (RS-U-0, RS-U-1) — un REVOKE sobre
# el dueño de una tabla no protege nada, porque el dueño se re-otorga solo.
# La contraseña se fija en la migración 0001; cámbiala en producción.
DATABASE_URL_APP=postgresql://lena_app:cambiame_en_el_despliegue@localhost:5432/lena

# ─────────────────────────────────────────────────────────────
# API
# ─────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3000

# Secretos de sesión (RS-A-7). Genera cada uno con:
#   openssl rand -base64 48
JWT_SECRET=genera_uno_con_openssl_rand_base64_48
REFRESH_SECRET=genera_otro_distinto_con_openssl_rand_base64_48

# ─────────────────────────────────────────────────────────────
# Negocio (RES-4)
# ─────────────────────────────────────────────────────────────
# El corte del día es a medianoche LOCAL, no UTC. Esto no es cosmético:
# un ::date sin convertir manda las ventas del sábado 8 PM al domingo y
# rompe el pronóstico por día de semana de la Fase 2 (RF-M-2).
TZ=America/Mexico_City
MONEDA=MXN
