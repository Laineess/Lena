# Caddy: TLS automático (RS-T-1), sirve la PWA y hace de reverse-proxy al API.
# En un mismo dominio no hace falta CORS (RS-T-4).
#
# Cambia lena.ejemplo.mx por el dominio real antes de desplegar.
lena.ejemplo.mx {
	encode gzip

	# HSTS y cabeceras de seguridad (RS-T-2, RS-T-3).
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), camera=(), microphone=()"
		# CSP: la app es autocontenida (sin CDN). 'unsafe-inline' en style por los
		# estilos en línea de React (colores de tarjeta de cocina, barras del admin).
		# connect-src incluye wss para el WebSocket de sync (mismo origen).
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ws: wss:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
		-Server
	}

	# El API: todo lo que sea sync, auth, catálogo, comandas y productos.
	@api path /auth/* /sync/* /catalogo* /comandas* /productos/*
	handle @api {
		reverse_proxy api:3000
	}

	# Todo lo demás: la PWA (SPA con fallback a index.html).
	handle {
		root * /srv/pwa
		try_files {path} /index.html
		file_server
	}
}
